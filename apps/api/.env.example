DATABASE_URL="postgresql://xiaotrack:change-me@localhost:5432/xiaotrack?schema=public"

SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_TEST_EMAIL="test@xiaotrack.local"
