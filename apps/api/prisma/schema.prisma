generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Application role 
enum Role {
  USER
  ADMIN

  @@map("user_role")
}

enum ExerciseCategory {
  RESISTANCE
  CARDIO

  @@map("exercise_category")
}

enum MeasureType {
  REPS_WEIGHT
  DURATION_DISTANCE

  @@map("measure_type")
}

enum SessionStatus {
  PLANNED
  IN_PROGRESS
  DONE
  // Step 2 only: a planned session that was not done
  SKIPPED

  @@map("session_status")
}

// Status of one exercise inside a session. "In progress" is not stored: it is the first PENDING one
enum SessionExerciseStatus {
  PENDING
  DONE
  SKIPPED

  @@map("session_exercise_status")
}

// One enum rather than two booleans, so "favourite and archived" cannot be written
enum UserExerciseState {
  NONE
  FAVORITE
  ARCHIVED

  @@map("user_exercise_state")
}

model User {
  // Generated by PostgreSQL itself, so an INSERT written by hand works too
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stored lowercase by the API (normalised before every write and lookup)
  email               String           @unique
  // Display name of the user
  displayName         String           @map("display_name")
  // argon2 hash, never the password itself
  passwordHash        String           @map("password_hash")
  // Sign-up always creates USER; ADMIN is only given by the seed
  role                Role             @default(USER)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Personal exercises created by this user
  exercises           Exercise[]
  // This user's preferences on exercises
  exercisePreferences UserExercise[]
  // Workouts of this user, planned or done
  workoutSessions     WorkoutSession[]

  @@map("users")
}

model Exercise {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stable key used by the seed to find a provided exercise again; null for personal exercises
  slug             String?           @unique
  // null = provided by the app (shared by everyone), otherwise created by this user
  ownerId          String?           @map("owner_id") @db.Uuid
  owner            User?             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Not unique: two users can each create their own "Bench press"
  name             String
  description      String?
  // Used to filter the catalogue
  category         ExerciseCategory
  // Which values a set records: reps + weight, or duration + distance
  measureType      MeasureType       @map("measure_type")
  // Each user's preferences on this exercise
  userPreferences  UserExercise[]
  // Every time this exercise was put in a session (the history)
  sessionExercises SessionExercise[]

  @@map("exercises")
}

// One user's preferences on one exercise (provided or personal). Created the first time they set one.
model UserExercise {
  userId             String            @map("user_id") @db.Uuid
  exerciseId         String            @map("exercise_id") @db.Uuid
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise           Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  // This user's usual rest on this exercise, copied into SessionExercise.restSeconds; null = the app default (90 s)
  defaultRestSeconds Int?              @map("default_rest_seconds")
  // NONE, FAVORITE (top of the lists) or ARCHIVED (hidden from planning, still shown in the history)
  state              UserExerciseState @default(NONE)

  // A user has at most one row per exercise
  @@id([userId, exerciseId])
  @@map("user_exercises")
}

// A workout, planned or done: the same row moves from PLANNED to IN_PROGRESS to DONE.
// Step 1 only has free sessions; templateId and programSlotId come with step 2.
model WorkoutSession {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Display only, not unique. Filled by the server ("Workout Nov 27") when the front sends none
  title            String
  ownerId          String            @map("owner_id") @db.Uuid
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Changed only through the start / finish actions, never by a plain update
  status           SessionStatus     @default(PLANNED)
  // Day the session is planned for, without a time; null = no date chosen
  scheduledDate    DateTime?         @map("scheduled_date") @db.Date
  // Set by "Start session"
  startedAt        DateTime?         @map("started_at") @db.Timestamptz(3)
  // Set by "Finish"
  endedAt          DateTime?         @map("ended_at") @db.Timestamptz(3)
  // How the session felt, 1 to 10, filled in at the end (range checked by the API DTO)
  feeling          Int?
  notes            String?
  // Orders the list when scheduledDate is null
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  // The exercises of this session, to sort by position
  sessionExercises SessionExercise[]

  // Every query filters by owner ("my sessions", "my session in progress")
  @@index([ownerId, status])
  @@map("workout_sessions")
}

// One exercise inside a session, in the order it is done
model SessionExercise {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workoutSessionId String                @map("workout_session_id") @db.Uuid
  // Deleting a session deletes its exercises (and, through them, their sets)
  workoutSession   WorkoutSession        @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId       String                @map("exercise_id") @db.Uuid
  // An exercise used in a session cannot be deleted: the history needs it
  exercise         Exercise              @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  // Order in the session, from 0. Not unique, so two exercises can swap places in two plain updates
  position         Int
  // PENDING until validated; a planned exercise that is not done becomes SKIPPED, never deleted
  status           SessionExerciseStatus @default(PENDING)
  // Copied from UserExercise.defaultRestSeconds (or 90 s) when the exercise is added
  restSeconds      Int                   @map("rest_seconds")
  // Cue written while planning ("slow descent"), shown during the sets
  instructions     String?
  // Conclusion written when the exercise is validated
  notes            String?
  // The sets of this exercise: their number is the number of sets
  sessionSets      SessionSet[]

  @@index([workoutSessionId, position])
  // "Last time I did this exercise", and the Restrict check when an exercise is deleted
  @@index([exerciseId])
  @@map("session_exercises")
}

// One set: the target and what was actually done live side by side on the same row.
// Which columns apply depends on measureType (reps + weight, or duration + distance), copied
// from the exercise; the others must stay null, enforced by a CHECK constraint written by hand
// in the migration (Prisma cannot declare one). Units: kg, seconds, metres.
model SessionSet {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionExerciseId String          @map("session_exercise_id") @db.Uuid
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  // Order within the exercise, from 0
  position          Int
  // Copied from Exercise.measureType when the set is created (safe: a used exercise's profile is frozen).
  // The database does not check that the copy matches the exercise: the service does.
  measureType       MeasureType     @map("measure_type")

  // Target, set while planning, frozen at Start; all optional.
  // Exact target = targetReps alone; range = targetReps (low end) + targetRepsMax, strictly greater (CHECK)
  targetReps     Int?     @map("target_reps")
  targetRepsMax  Int?     @map("target_reps_max")
  // Up to 9999.99 kg; 0 = bodyweight. Prisma returns a Decimal object, sent as a string in JSON
  targetWeight   Decimal? @map("target_weight") @db.Decimal(6, 2)
  targetDuration Int?     @map("target_duration")
  // null when distance does not apply (plank), never 0
  targetDistance Int?     @map("target_distance")

  // Actually done, filled in during the session. Empty = nothing typed; whether the set is done is completedAt
  actualReps     Int?      @map("actual_reps")
  actualWeight   Decimal?  @map("actual_weight") @db.Decimal(6, 2)
  actualDuration Int?      @map("actual_duration")
  actualDistance Int?      @map("actual_distance")
  // Effort of the set, 1 to 10 (range checked by the API DTO)
  rpe            Int?
  // Remark on this set, written during the session
  notes          String?
  // When the set was ticked off; null = not done (unticking clears it and keeps the actual values)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([sessionExerciseId, position])
  @@map("session_sets")
}
