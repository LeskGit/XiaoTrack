
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Application role 
enum Role {
  USER
  ADMIN

  @@map("user_role")
}

model User {
  // Generated by PostgreSQL itself, so an INSERT written by hand works too
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stored lowercase by the API (normalised before every write and lookup)
  email        String   @unique
  // argon2 hash, never the password itself
  passwordHash String   @map("password_hash")
  // Sign-up always creates USER; ADMIN is only given by the seed
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}