{
  "info": {
    "name": "XiaoTrack API",
    "description": "Manual tests for the XiaoTrack NestJS API (apps/api).\n\nImport this collection AND `xiaotrack-local.postman_environment.json`, then select the `XiaoTrack - local` environment (top right).\n\nRun order for the Auth folder: run it as a whole with the Collection Runner, or run `Register - new user` first: it creates a fresh user (random email) that the following requests reuse.\n\nPostman keeps the `access_token` cookie set by a login (Cookies link under the Send button) and sends it back on the next requests, like a browser: `Me - logged in` works only after a login.\n\nEvery request has tests (Tests / Scripts tab) that check the status code and the response shape.\n\nToken tests: the `Me - ...` requests after `Me - after logout (401)` send a hand-made `Cookie` header (copied or forged from the token of `Login - registered user`). They must run AFTER the logout, so that Postman's own cookie jar does not send a valid access_token alongside.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "testPassword",
      "value": "motdepasse123",
      "description": "Password used for the users created by this collection (throwaway test value)."
    },
    {
      "key": "registeredEmail",
      "value": "",
      "description": "Set automatically by `Register - new user`."
    },
    {
      "key": "capturedToken",
      "value": "",
      "description": "Set automatically by `Login - registered user`: a copy of the access_token cookie."
    },
    {
      "key": "forgedToken",
      "value": "",
      "description": "Set automatically by the forged-token requests."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Hello",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Database health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/db"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Reports a user count', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(body.users).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"  {{registeredEmailRaw}} \",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh email on every run, with uppercase + spaces to check the normalisation",
                  "const email = `Postman-${Date.now()}@Test.local`;",
                  "pm.collectionVariables.set('registeredEmailRaw', email);",
                  "pm.collectionVariables.set('registeredEmail', email.toLowerCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Email is trimmed and lowercased', () => {",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('registeredEmail'));",
                  "});",
                  "pm.test('Role is USER', () => pm.expect(body.role).to.eql('USER'));",
                  "pm.test('No password hash in the response', () => {",
                  "  pm.expect(body).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - email already used (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - invalid body (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Lists every validation error', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message).to.be.an('array').with.length.greaterThan(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - extra role field (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"hacker@test.local\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request (mass assignment blocked)', () => pm.response.to.have.status(400));",
                  "pm.test('Says role should not exist', () => {",
                  "  pm.expect(pm.response.text()).to.include('property role should not exist');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.collectionVariables.set('wrongPasswordBody', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - unknown email (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@test.local\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "const previous = pm.collectionVariables.get('wrongPasswordBody');",
                  "if (previous) {",
                  "  pm.test('Same response as a wrong password (no account enumeration)', () => {",
                  "    pm.expect(pm.response.text()).to.eql(previous);",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - seeded admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Role is ADMIN', () => pm.expect(pm.response.json().role).to.eql('ADMIN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - registered user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns the public user', () => {",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('registeredEmail'));",
                  "  pm.expect(body).to.not.have.property('passwordHash');",
                  "});",
                  "pm.test('Sets the access_token cookie', () => {",
                  "  pm.expect(pm.cookies.has('access_token')).to.be.true;",
                  "});",
                  "pm.test('The token is NOT in the body (it lives in the httpOnly cookie)', () => {",
                  "  pm.expect(pm.response.text()).to.not.include(pm.cookies.get('access_token'));",
                  "});",
                  "// Kept for the token tests that run after the logout",
                  "pm.collectionVariables.set('capturedToken', pm.cookies.get('access_token'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - logged in",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Is the user of the cookie', () => {",
                  "  pm.expect(body.email).to.eql(pm.collectionVariables.get('registeredEmail'));",
                  "});",
                  "pm.test('No password hash in the response', () => {",
                  "  pm.expect(body).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - after logout (401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - token kept from before logout (200, known V1 limit)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token={{capturedToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Logout only asks the browser to drop its cookie: the token itself stays valid until exp.",
                  "// No revocation in V1 (docs/auth/00-cadrage-v1.md). This test documents the limit.",
                  "pm.test('200 OK: a copied token still works after logout', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - tampered signature (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token={{forgedToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Same header and payload, last character of the signature changed",
                  "const token = pm.collectionVariables.get('capturedToken');",
                  "const last = token.slice(-1) === 'A' ? 'B' : 'A';",
                  "pm.collectionVariables.set('forgedToken', token.slice(0, -1) + last);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Rejected cleanly, not a server crash (no 500)', () => {",
                  "  pm.expect(pm.response.json().statusCode).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - role changed to ADMIN (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token={{forgedToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// What an attacker does on jwt.io: edit the readable payload, keep the old signature",
                  "const fromB64Url = (s) => atob(s.replace(/-/g, '+').replace(/_/g, '/'));",
                  "const toB64Url = (s) => btoa(s).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "const [header, payload, signature] = pm.collectionVariables.get('capturedToken').split('.');",
                  "const claims = JSON.parse(fromB64Url(payload));",
                  "claims.role = 'ADMIN';",
                  "pm.collectionVariables.set('forgedToken', [header, toB64Url(JSON.stringify(claims)), signature].join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Rejected cleanly, not a server crash (no 500)', () => {",
                  "  pm.expect(pm.response.json().statusCode).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - alg none, no signature (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token={{forgedToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Historic attack: the token declares itself unsigned. A configured secret must refuse it.",
                  "const fromB64Url = (s) => atob(s.replace(/-/g, '+').replace(/_/g, '/'));",
                  "const toB64Url = (s) => btoa(s).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "const payload = pm.collectionVariables.get('capturedToken').split('.')[1];",
                  "const claims = JSON.parse(fromB64Url(payload));",
                  "claims.role = 'ADMIN';",
                  "const header = toB64Url(JSON.stringify({ alg: 'none', typ: 'JWT' }));",
                  "pm.collectionVariables.set('forgedToken', `${header}.${toB64Url(JSON.stringify(claims))}.`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Rejected cleanly, not a server crash (no 500)', () => {",
                  "  pm.expect(pm.response.json().statusCode).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Me - not a JWT (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "access_token={{notAJwt}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('notAJwt', 'not-a-jwt');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Rejected cleanly, not a server crash (no 500)', () => {",
                  "  pm.expect(pm.response.json().statusCode).to.eql(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
